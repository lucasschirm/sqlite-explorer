{
  "name": "slitex",
  "version": "0.1.0",
  "description": "Browser-based SQLite viewer — use it as a website or open local databases straight from the terminal with `slitex <file>`.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "bin": {
    "slitex": "./bin/slitex.js"
  },
  "files": [
    "bin",
    "cli",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "oclif": {
    "bin": "slitex",
    "commands": {
      "strategy": "single",
      "target": "./cli/commands/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsc -p tsconfig.cli.json",
    "lint": "oxlint",
    "preview": "vite preview",
    "cli": "node bin/slitex.js",
    "demo:db": "bun scripts/make-demo-db.js",
    "wal:db": "bun scripts/make-wal-test-db.js",
    "model:fetch": "bun scripts/fetch-model.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@oclif/core": "^5.0.0",
    "fastify": "^5.12.3",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "monaco-editor": "^0.56.0",
    "oxlint": "^1.79.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql-formatter": "^15.8.2",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wa-sqlite": "^1.0.0"
  }
}
